#!/usr/bin/make -f
export PYBUILD_NAME=copyparty
export PYBUILD_SYSTEM=pyproject
%:
	dh $@ --buildsystem=pybuild

# For discussion see rules_unacceptable_kludge.py
include /usr/share/dpkg/pkg-info.mk
