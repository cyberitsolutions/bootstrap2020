--- libipuz-0.5.4.orig/libipuz/rust/Cargo.toml
+++ libipuz-0.5.4/libipuz/rust/Cargo.toml
@@ -3,17 +3,17 @@ name = "ipuz_rust"
 version = "0.1.0"
 edition = "2021"
 authors = ["Federico Mena Quintero <federico@gnome.org>"]
-rust-version = "1.85.1"
+rust-version = "1.94"
 
 [lib]
 crate-type = [ "staticlib" ]
 
 [dependencies]
-gio = "0.20"
-glib = "0.20"
-glib-sys = "0.20"
+gio = "0.21"
+glib = "0.21"
+glib-sys = "0.21"
 libc = "0.2"
 nohash-hasher = "0.2.0"
-rand = "0.9.1"
-serde = { version = "1.0.203", features = ["derive"] }
-serde_json = "1.0.114"
+rand = "0.10"
+serde = { version = "1.0", features = ["derive"] }
+serde_json = "1.0"
