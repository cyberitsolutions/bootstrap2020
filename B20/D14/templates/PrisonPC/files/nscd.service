# This is a drop-in file that hardens nscd, just because we can.

# Hardening
[Service]
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
PrivateMounts=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
ProtectHostname=yes
LockPersonality=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictRealtime=yes
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
ProtectHome=yes
PrivateNetwork=yes
PrivateUsers=yes
PrivateTmp=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=~@resources
IPAddressDeny=any
UMask=0077


# Loosening
[Service]
# To do its core job, unscd has to be able to resolve users.
PrivateUsers=no
# As at Debian 14 / systemd v260 / linux 6.19,
# PrivateNetwork=yes also makes AF_UNIX sockets in /run private!
PrivateNetwork=no
# Not sure if this is needed but I'll chuck it in anyway. --twb, April 2026
# IPAddressAllow=localhost

# systemd-analyze security doesn't explicitly call these out, but
# they are a minor help
[Service]
RuntimeDirectory=%p
WorkingDirectory=/run/%p
# This is only used if you have "persistent <table> yes" in nscd.conf.
# It allows nscd to cache its internal cache between reboots of nscd.
# This is on by default in Debian, but off by default in PrisonPC.
# Always setting it here does not hurt.
CacheDirectory=%p


# The upstream has ExecStart=nscd ...; ExecStop=nscd --shutdown.
# But because we run nscd as unprivileged user, we need to add an "!" (run as root) to the ExecStop.
# Otherwise we get this:
#   # systemctl stop nscd
#   nscd[16109]: /usr/sbin/nscd: Only root is allowed to use this option!
#   [stops anyway, but less gracfeully]
[Service]
ExecStop=
ExecStop=!/usr/sbin/nscd --shutdown
