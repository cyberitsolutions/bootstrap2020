# https://git.cyber.com.au/prisonpc/raw/25.12/doc/wordmark/24019-PrisonPC-trademark.svg
# (I think just recolored). --twb, August 2026
name = "usr/share/plymouth/themes/spinner/bgrt-fallback.png"
