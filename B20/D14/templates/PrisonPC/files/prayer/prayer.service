[Unit]
Requires=%p.socket
After=%p.socket
[Install]
Also=%p.socket
[Service]
# NOTE: The mail domain is site-specific and not included in the SOE.
#       PrisonPC 25+ adds /etc/mailname via /srv/netboot/images/X/tca.squashfs.
#       prayer-systemd-generator.py sets $ERRATA based on /etc/mailname.
ExecStart=/usr/sbin/prayer --foreground --ports=80:0:3 $ERRATA
RuntimeDirectory=prayer
User=prayer
SyslogFacility=mail
NoNewPrivileges=1


# Hardening
[Service]
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
PrivateMounts=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
ProtectHostname=yes
LockPersonality=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictRealtime=yes
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
ProtectHome=yes
PrivateNetwork=yes
PrivateUsers=yes
PrivateTmp=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=~@resources
IPAddressDeny=any
UMask=0077


# Loosening
[Service]
RuntimeDirectory=%p
StateDirectory=%p
CacheDirectory=%p
LogsDirectory=%p
ConfigurationDirectory=%p
WorkingDirectory=/run/%p
# Enough for IMAP & fork+exec msmtp (SMTP).
# Prayer DOES NOT support talking directly to smtp://localhost:25.
# Further discussion about mail hardening here:
# https://github.com/cyberitsolutions/prisonpc-systemd-lockdown/
PrivateNetwork=no
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressAllow=10.0.0.1 10.128.0.1
# Allow IP addresses used by --boot-test.
# Strictly speaking they should not be allowed in prod, but
# the impact is low.
IPAddressAllow=10.0.2.100 10.128.2.100
